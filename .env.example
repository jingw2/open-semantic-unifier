# 零点未来 · 企业语义统一平台（Semantic Unifier Platform）环境变量模板
APP_NAME=零点未来 · 企业语义统一平台
APP_ENV=production

# 安全与密钥：使用 `python3 scripts/init_env.py` 生成私有 .env，不要直接部署本模板。
JWT_SECRET_KEY=generate-with-scripts-init-env
APP_ENCRYPTION_KEY=generate-with-scripts-init-env

# 首次启动自动初始化超级管理员（默认关闭公开注册）
INIT_ADMIN_EMAIL=admin@lingdianweilai.ai
INIT_ADMIN_PASSWORD=generate-with-scripts-init-env
INIT_ADMIN_NAME=系统管理员
INIT_WORKSPACE_NAME=零点未来默认工作空间
ALLOW_PUBLIC_SIGNUP=false

# PostgreSQL 16
POSTGRES_DB=semantic_unifier
POSTGRES_USER=su_admin
POSTGRES_PASSWORD=generate-with-scripts-init-env
DATABASE_URL=sqlite:///./local_dev.db

# Redis & Celery（Docker 生产环境设为 true；本地轻量测试可设为 false）
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_ENABLED=false
# Maximum execution attempts per unification run before it fails terminally.
UNIFICATION_MAX_ATTEMPTS=3

# Phoenix (optional; start with `docker compose --profile observability up phoenix`)
PHOENIX_ENABLED=false
PHOENIX_COLLECTOR_ENDPOINT=http://phoenix:6006/v1/traces
OTEL_SERVICE_NAME=open-semantic-unifier
OTEL_EXPORT_TIMEOUT_SECONDS=1.0
LLM_TIMEOUT_SECONDS=30.0

# 对象存储（Docker 生产环境设为 s3；本地开发设为 local）
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./local_storage
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY=semantic-unifier
S3_SECRET_KEY=generate-with-scripts-init-env
MINIO_ACCESS_KEY=semantic-unifier
MINIO_SECRET_KEY=generate-with-scripts-init-env
S3_BUCKET=semantic-unifier
