{
  "id": "normalize_whitespace",
  "name": "空格归一",
  "description": "去掉首尾空格，并把连续空格合并为一个。",
  "version": "1.0.0",
  "priority": 40,
  "match": {
    "column_terms": ["company", "supplier", "customer", "name", "公司", "供应商", "客户", "名称"],
    "requires_whitespace_noise": true,
    "requires_columns": []
  },
  "limits": {"max_rows": 50000, "max_bytes": 10485760, "max_columns": 256},
  "operations": [
    {
      "op": "core/text-transform",
      "description": "归一空格",
      "engineConfig": {"facets": [], "mode": "row-based"},
      "columnName": "${name_col}",
      "expression": "value.trim().split(/\\s+/).join(' ')",
      "onError": "keep-original",
      "repeat": false,
      "repeatCount": 1
    }
  ]
}
