{
  "id": "remove_legal_suffix",
  "name": "去掉公司法律后缀",
  "description": "去掉名称末尾的“股份有限公司 / 有限责任公司 / 有限公司 / 集团”，保留主体名称。",
  "version": "1.0.0",
  "priority": 60,
  "match": {
    "column_terms": ["company", "supplier", "company_name", "公司", "供应商", "企业"],
    "requires_whitespace_noise": false,
    "requires_columns": []
  },
  "limits": {"max_rows": 50000, "max_bytes": 10485760, "max_columns": 256},
  "operations": [
    {
      "op": "core/text-transform",
      "description": "去掉法律后缀",
      "engineConfig": {"facets": [], "mode": "row-based"},
      "columnName": "${name_col}",
      "expression": "value.trim().replace(/(股份有限公司|有限责任公司|有限公司|集团)$/,'')",
      "onError": "keep-original",
      "repeat": false,
      "repeatCount": 1
    }
  ]
}
