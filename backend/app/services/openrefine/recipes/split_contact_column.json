{
  "id": "split_contact_column",
  "name": "拆分联系方式",
  "description": "把用分号、逗号或顿号分隔的联系方式拆成多列，原列删除。",
  "version": "1.0.0",
  "priority": 10,
  "match": {
    "column_terms": ["contact", "phone", "mobile", "email", "联系方式", "电话", "邮箱"],
    "requires_whitespace_noise": false,
    "requires_columns": []
  },
  "limits": {"max_rows": 50000, "max_bytes": 10485760, "max_columns": 256},
  "operations": [
    {
      "op": "core/column-split",
      "description": "拆分联系方式",
      "engineConfig": {"facets": [], "mode": "row-based"},
      "columnName": "${contact_col}",
      "mode": "separator",
      "separator": "[;；,，、]",
      "regex": true,
      "maxColumns": 50,
      "guessCellType": true,
      "removeOriginalColumn": true
    }
  ]
}
