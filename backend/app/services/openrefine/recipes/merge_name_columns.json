{
  "id": "merge_name_columns",
  "name": "合并姓名字段",
  "description": "把 first_name 与 last_name 合并成 full_name，保留原来的两列。",
  "version": "1.0.0",
  "priority": 20,
  "match": {
    "column_terms": ["first_name", "last_name"],
    "requires_whitespace_noise": false,
    "requires_columns": ["first_name", "last_name"]
  },
  "limits": {"max_rows": 50000, "max_bytes": 10485760, "max_columns": 256},
  "operations": [
    {
      "op": "core/column-addition",
      "description": "合并姓名",
      "engineConfig": {"facets": [], "mode": "row-based"},
      "newColumnName": "full_name",
      "columnInsertIndex": 1,
      "baseColumnName": "${first_name_col}",
      "expression": "join([cells['${first_name_col}'].value,cells['${last_name_col}'].value],' ')",
      "onError": "keep-original"
    }
  ]
}
