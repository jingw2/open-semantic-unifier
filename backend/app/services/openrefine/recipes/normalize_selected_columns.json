{
  "id": "normalize_selected_columns",
  "name": "按列归一所选字段",
  "description": "对勾选的每一列去掉首尾空格，并把连续空格合并为一个。",
  "version": "1.0.0",
  "priority": 5,
  "mode": "per_column",
  "match": {
    "column_terms": ["name", "company", "supplier", "customer", "公司", "名称", "供应商", "客户"],
    "requires_whitespace_noise": false,
    "requires_columns": []
  },
  "limits": {"max_rows": 50000, "max_bytes": 10485760, "max_columns": 256},
  "operations": [
    {
      "op": "core/text-transform",
      "description": "归一所选字段",
      "engineConfig": {"facets": [], "mode": "row-based"},
      "columnName": "${column}",
      "expression": "value.trim().split(/\\s+/).join(' ')",
      "onError": "keep-original",
      "repeat": false,
      "repeatCount": 1
    }
  ]
}
