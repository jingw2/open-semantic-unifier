{
  "id": "normalize_punctuation",
  "name": "标点归一",
  "description": "清理名称中的全角/半角括号、间隔号和常见逗号句号，再合并空格。",
  "version": "1.0.0",
  "priority": 50,
  "match": {
    "column_terms": ["company", "supplier", "customer", "name", "公司", "供应商", "客户", "名称"],
    "requires_whitespace_noise": false,
    "requires_columns": []
  },
  "limits": {"max_rows": 50000, "max_bytes": 10485760, "max_columns": 256},
  "operations": [
    {
      "op": "core/text-transform",
      "description": "清理标点",
      "engineConfig": {"facets": [], "mode": "row-based"},
      "columnName": "${name_col}",
      "expression": "value.trim().split(/[（）()【】·,，.。]/).join('').split(/\\s+/).join(' ')",
      "onError": "keep-original",
      "repeat": false,
      "repeatCount": 1
    }
  ]
}
