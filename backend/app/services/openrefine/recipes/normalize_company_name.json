{
  "id": "normalize_company_name",
  "name": "公司名称归一",
  "description": "去掉首尾空格，合并连续空格，清理常见标点，去掉法律实体后缀，并统一英文大小写。",
  "version": "1.0.0",
  "priority": 30,
  "match": {
    "column_terms": ["company", "supplier", "customer", "name", "公司", "供应商", "客户", "名称"],
    "requires_whitespace_noise": false,
    "requires_columns": []
  },
  "limits": {"max_rows": 50000, "max_bytes": 10485760, "max_columns": 256},
  "operations": [
    {
      "op": "core/text-transform",
      "description": "归一公司名称",
      "engineConfig": {"facets": [], "mode": "row-based"},
      "columnName": "${name_col}",
      "expression": "value.trim().replace(/(股份有限公司|有限责任公司|有限公司|集团)$/,'').split(/[（）()【】·,，.。]/).join('').split(/\\s+/).join(' ').toLowercase()",
      "onError": "keep-original",
      "repeat": false,
      "repeatCount": 1
    }
  ]
}
